{
	"name": "blank-board",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2024-12-01",
	"compatibility_flags": ["nodejs_compat"],

	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare/",
		"not_found_handling": "single-page-application"
	},

	"vars": {
		"ADMIN_USERNAME": "admin"
		// Secrets — set with wrangler secret put:
		//   wrangler secret put ADMIN_PASSWORD
	},

	// Create with: wrangler d1 create blank-board
	// Then replace YOUR_D1_DATABASE_ID below with the returned ID
	// Migrations:
	//   wrangler d1 migrations apply DB --local   (dev)
	//   wrangler d1 migrations apply DB           (prod)
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "blank-board",
			"database_id": "b6adff2d-3337-4180-9ffd-23d961bd4496"
		}
	],

	// Create with: wrangler kv namespace create SESSIONS
	// Then replace YOUR_KV_NAMESPACE_ID below with the returned ID
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "91b984c16cc949be95e8197e0b67cb70"
		}
	],

	// Create with: wrangler r2 bucket create blank-board-files
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "blank-board"
		}
	],

	"durable_objects": {
		"bindings": [
			{
				"name": "USER_SYNC",
				"class_name": "UserSync"
			}
		]
	},

	"migrations": [
		{
			"tag": "v1",
			"new_classes": ["UserSync"]
		}
	]
}
